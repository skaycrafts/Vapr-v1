# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ungraded source photography and video (not deployed).
#
# Written as `/*` rather than `/media-source` so the exception below can work
# at all: git does not descend into an ignored directory, so a negation for
# something inside one is never even considered.
/media-source/*
# The identity master is the exception. It is 250kB, not gigabytes of raw
# frames, and every asset in public/brand is derived from it by
# scripts/build-brand.mjs — ignoring it would make the logo the one thing in
# this repository that cannot be rebuilt from this repository.
!/media-source/brand
