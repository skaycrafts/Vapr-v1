# Normalise to LF in the repository; Git checks out native line endings.
* text=auto eol=lf

# Binary media — never diffed or line-ending converted.
*.avif  binary
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.mp4   binary
*.woff2 binary
*.ico   binary

# Generated by scripts/optimize-media.mjs; collapse it in diffs and reviews.
lib/media.generated.ts linguist-generated=true -diff
